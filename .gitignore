# Disenchanted .gitignore

# Dependencies (ModuLLe cloned during setup)
deps/

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
*.egg-info/
dist/
build/
*.egg

# Virtual Environment
venv/
env/
ENV/
.venv

# IDE
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store

# Configuration (user-specific)
.disenchanted.json
.modulle-gui.json

# Logs
*.log

# PyQt
*.ui.py
*.qrc.py

# Testing
.pytest_cache/
.coverage
htmlcov/

# Temporary files
*.tmp
*.bak
.cache/
